# ============================================
# CONFIGURATION MULTI-FOURNISSEUR SMTP
# Cosmos Group - Configuration des emails
# ============================================

# ============================================
# SERVEUR PERSONNALISÉ (Priorité 1)
# ============================================
SMTP_HOST=mail.emergencemag.net
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=contact1@emergencemag.net
SMTP_PASSWORD=votre_mot_de_passe
SMTP_FROM_EMAIL=contact1@emergencemag.net
SMTP_FROM_NAME=Cosmos Group

# ============================================
# GMAIL (Priorité 2)
# ============================================
# Pour utiliser Gmail, vous devez créer un "Mot de passe d'application"
# 1. Allez sur https://myaccount.google.com/security
# 2. Activez la validation en 2 étapes
# 3. Créez un mot de passe d'application
# 4. Utilisez ce mot de passe ici (pas votre mot de passe Gmail normal)

GMAIL_USERNAME=votre@gmail.com
GMAIL_PASSWORD=mot_de_passe_application_16_caracteres

# Configuration spécifique par canal (optionnel)
GMAIL_CANDIDATURE_USERNAME=candidatures@gmail.com
GMAIL_CANDIDATURE_PASSWORD=mot_de_passe_application

GMAIL_NEWSLETTER_USERNAME=newsletter@gmail.com
GMAIL_NEWSLETTER_PASSWORD=mot_de_passe_application

GMAIL_CONTACT_USERNAME=contact@gmail.com
GMAIL_CONTACT_PASSWORD=mot_de_passe_application

# ============================================
# OUTLOOK / HOTMAIL (Priorité 3)
# ============================================
# Pour Outlook/Hotmail, utilisez votre mot de passe normal
# ou créez un mot de passe d'application si vous avez activé 2FA

OUTLOOK_USERNAME=votre@outlook.com
OUTLOOK_PASSWORD=votre_mot_de_passe

# Configuration spécifique par canal (optionnel)
OUTLOOK_CANDIDATURE_USERNAME=candidatures@outlook.com
OUTLOOK_CANDIDATURE_PASSWORD=votre_mot_de_passe

OUTLOOK_NEWSLETTER_USERNAME=newsletter@hotmail.com
OUTLOOK_NEWSLETTER_PASSWORD=votre_mot_de_passe

OUTLOOK_CONTACT_USERNAME=contact@outlook.com
OUTLOOK_CONTACT_PASSWORD=votre_mot_de_passe

# ============================================
# YAHOO MAIL (Priorité 3)
# ============================================
# Pour Yahoo, vous devez créer un "Mot de passe d'application"
# 1. Allez sur https://login.yahoo.com/account/security
# 2. Générez un mot de passe d'application
# 3. Utilisez ce mot de passe ici

YAHOO_USERNAME=votre@yahoo.com
YAHOO_PASSWORD=mot_de_passe_application

# Configuration spécifique par canal (optionnel)
YAHOO_CONTACT_USERNAME=contact@yahoo.com
YAHOO_CONTACT_PASSWORD=mot_de_passe_application

# ============================================
# SENDGRID (Service professionnel - Priorité 5)
# ============================================
# SendGrid est recommandé pour les newsletters
# 1. Créez un compte sur https://sendgrid.com
# 2. Créez une API Key
# 3. Le username est toujours "apikey"

SENDGRID_USERNAME=apikey
SENDGRID_PASSWORD=votre_api_key_sendgrid

# Configuration spécifique pour newsletter
SENDGRID_NEWSLETTER_USERNAME=apikey
SENDGRID_NEWSLETTER_PASSWORD=votre_api_key_sendgrid

# ============================================
# MAILGUN (Service professionnel - Priorité 6)
# ============================================
# Mailgun est une alternative à SendGrid
# 1. Créez un compte sur https://www.mailgun.com
# 2. Configurez votre domaine
# 3. Récupérez vos credentials SMTP

MAILGUN_USERNAME=postmaster@votre-domaine.mailgun.org
MAILGUN_PASSWORD=votre_api_key_mailgun

# Configuration spécifique pour newsletter
MAILGUN_NEWSLETTER_USERNAME=postmaster@votre-domaine.mailgun.org
MAILGUN_NEWSLETTER_PASSWORD=votre_api_key_mailgun

# ============================================
# EMAILS DE DESTINATION
# ============================================
# Emails où les notifications seront envoyées

ADMIN_EMAIL=web@emergencemag.net
CONTACT_EMAIL=contact1@emergencemag.net
NEWS_EMAIL=news@emergencemag.net

# ============================================
# OPTIONS AVANCÉES
# ============================================
# Activer le basculement automatique entre fournisseurs
SMTP_ENABLE_FALLBACK=true

# Nombre de tentatives par fournisseur avant de passer au suivant
SMTP_MAX_RETRY_ATTEMPTS=3

# Délai entre les tentatives (en secondes)
SMTP_RETRY_DELAY=1

# Timeout de connexion SMTP (en secondes)
SMTP_TIMEOUT=30

# Activer les logs détaillés
SMTP_ENABLE_LOGGING=true

# Mode simulation (pour le développement - ne pas activer en production)
SMTP_SIMULATE_SENDING=false

# ============================================
# NOTES IMPORTANTES
# ============================================
# 
# 1. PRIORITÉ DES FOURNISSEURS :
#    Le système essaie les fournisseurs dans l'ordre de priorité.
#    Si un fournisseur échoue, il passe automatiquement au suivant.
#
# 2. CONFIGURATION PAR CANAL :
#    - Candidatures : Utilise SMTP custom, puis Gmail, puis Outlook
#    - Newsletter : Utilise SMTP custom, puis SendGrid, puis Mailgun
#    - Contact : Utilise SMTP custom, puis Yahoo
#
# 3. MOTS DE PASSE D'APPLICATION :
#    Gmail et Yahoo nécessitent des mots de passe d'application
#    si vous avez activé la validation en 2 étapes.
#
# 4. SÉCURITÉ :
#    - Ne commitez JAMAIS ce fichier avec vos vrais mots de passe
#    - Créez un fichier .env avec vos vraies valeurs
#    - Ajoutez .env à votre .gitignore
#
# 5. TEST :
#    Testez chaque fournisseur individuellement avant de les activer tous
#
